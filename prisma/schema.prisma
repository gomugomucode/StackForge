generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
  RECRUITER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id                 String              @id @default(cuid())
  name               String?
  email              String?             @unique
  password           String?
  emailVerified      DateTime?
  avatar             String?
  role               Role                @default(USER)
  publicProfile      Boolean             @default(true)
  githubUsername     String?
  githubAvatar       String?
  plan               String              @default("FREE")
  stripeCustomerId   String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  accounts           Account[]
  achievements       Achievement[]
  bookmarks          Bookmark[]
  certifications     Certification[]
  challengeProgress  ChallengeProgress[]
  memberships        CircleMembership[]
  dailyActivities    DailyActivity[]
  profile            Profile?
  progress           Progress[]
  submissions        ProjectSubmission[]
  quizAttempts       QuizAttempt[]
  reviews            Review[]
  roadmapCompletions RoadmapCompletion[]
  sessions           Session[]
  streakTrackings    StreakTracking?
  topicProgress      TopicProgress[]
  tutorSessions      TutorSession[]
  xpTransactions     XpTransaction[]
  skillProficiencies SkillProficiency[]
  interviewSessions  InterviewSession[]
  contentVersions    ContentVersion[]
  auditLogs          AdminAuditLog[]
  notifications      Notification[]
  spacedRepetitions  SpacedRepetition[]
}

model Profile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  xp                  Int      @default(0)
  streak              Int      @default(0)
  level               Int      @default(1)
  totalHours          Int      @default(0)
  skillLevel          String?  @default("Beginner")
  interests           String[] @default([])
  goal                String?
  onboardingCompleted Boolean  @default(false)
  lastActive          DateTime @default(now())
  joinedAt            DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Progress {
  id           String    @id @default(cuid())
  userId       String
  lessonId     String
  completed    Boolean   @default(false)
  lastAccessed DateTime  @default(now())
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  resourceId String
  type       String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
}

model Certification {
  id               String   @id @default(cuid())
  userId           String
  roadmapId        String
  issuedAt         DateTime @default(now())
  score            Int
  verificationCode String   @unique @default(cuid())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap          Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([userId, roadmapId])
}

model Circle {
  id          String             @id @default(cuid())
  name        String
  description String?
  roadmapId   String?
  createdAt   DateTime           @default(now())
  members     CircleMembership[]
}

model CircleMembership {
  id       String   @id @default(cuid())
  userId   String
  circleId String
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())
  circle   Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, circleId])
}

model ProjectSubmission {
  id          String         @id @default(cuid())
  userId      String
  projectId   String
  repoUrl     String
  demoUrl     String?
  description String?
  createdAt   DateTime       @default(now())
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews     Review[]
  autoReview  ProjectReview?
}

model Review {
  id           String            @id @default(cuid())
  userId       String
  submissionId String
  rating       Int
  comment      String
  createdAt    DateTime          @default(now())
  submission   ProjectSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id             String   @id @default(cuid())
  userId         String
  quizId         String
  score          Int
  percentage     Int
  passed         Boolean  @default(false)
  correctAnswers Int
  completedAt    DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Roadmap {
  id             String              @id @default(cuid())
  slug           String              @unique
  title          String
  description    String
  category       String
  color          String
  icon           String
  overview       String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  finalExam      FinalExam?
  modules        Module[]
  certifications Certification[]
  completions    RoadmapCompletion[]
}

model Module {
  id          String   @id @default(cuid())
  roadmapId   String
  slug        String
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lessons     Lesson[]
  roadmap     Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
}

model Lesson {
  id             String             @id @default(cuid())
  moduleId       String
  slug           String
  title          String
  description    String
  whatIsIt       String
  whyItMatters   String
  syntax         String
  declaration    String
  example        String
  commonMistakes String
  practiceTask   String
  quizId         String?
  cheatsheetId   String?
  interviewId    String?
  difficulty     String             @default("beginner")
  estimatedHours Int                @default(1)
  prerequisites  String[]
  status         ContentStatus      @default(PUBLISHED)
  version        Int                @default(1)
  skillsGained   String[]           @default([])
  xpAwarded      Int                @default(50)
  seoTitle       String?
  seoDescription String?
  seoKeywords    String[]           @default([])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  module         Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  resources      Resource[]
  progress       Progress[]
  targetDeps     LessonDependency[] @relation("TargetLesson")
  prereqDeps     LessonDependency[] @relation("PrereqLesson")
}

model Resource {
  id       String @id @default(cuid())
  lessonId String
  title    String
  url      String
  type     String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model CheatSheet {
  id        String   @id @default(cuid())
  lessonId  String?
  topicId   String?
  slug      String   @unique
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  topic     Topic?   @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model InterviewQuestion {
  id               String   @id @default(cuid())
  lessonId         String?
  topicId          String?
  question         String
  answer           String
  difficulty       String
  tags             String[]
  companyFrequency Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  topic            Topic?   @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model Project {
  id          String              @id @default(cuid())
  title       String
  description String
  difficulty  String
  roadmapId   String?
  topicId     String?
  resources   String[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  topic       Topic?              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  submissions ProjectSubmission[]
}

model FinalExam {
  id           String     @id @default(cuid())
  roadmapId    String     @unique
  passingScore Int
  roadmap      Roadmap    @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  questions    Question[]
}

model Quiz {
  id          String     @id @default(cuid())
  title       String
  description String?
  difficulty  String
  type        String     @default("full")
  lessonId    String?
  roadmapId   String?
  topicId     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  questions   Question[]
  topic       Topic?     @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model Question {
  id          String     @id @default(cuid())
  quizId      String?
  examId      String?
  question    String
  options     String[]
  answer      String
  explanation String?
  difficulty  String
  exam        FinalExam? @relation(fields: [examId], references: [id], onDelete: Cascade)
  quiz        Quiz?      @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model Topic {
  id                 String              @id @default(cuid())
  slug               String              @unique
  technology         String
  title              String
  description        String
  difficulty         String
  estimatedTime      Int                 @default(60)
  prerequisites      String[]
  learningObjectives String[]
  tags               String[]
  nextTopics         String[]
  roadmapId          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  challenges         Challenge[]
  cheatSheets        CheatSheet[]
  interviews         InterviewQuestion[]
  projects           Project[]
  quizzes            Quiz[]
  content            TopicContent?
  examples           TopicExample[]
  progress           TopicProgress[]
}

model TopicContent {
  id                  String   @id @default(cuid())
  topicId             String   @unique
  whatIsIt            String?
  whyItMatters        String?
  overview            String
  syntax              String
  explanation         String
  visualExplanation   String?
  beginnerExample     String?
  intermediateExample String?
  advancedExample     String?
  summary             String?
  bestPractices       String[]
  commonMistakes      String[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  topic               Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model TopicExample {
  id          String   @id @default(cuid())
  topicId     String
  title       String
  code        String
  output      String
  explanation String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model Challenge {
  id             String   @id @default(cuid())
  topicId        String
  title          String
  description    String
  difficulty     String
  solution       String
  hints          String[]
  expectedOutput String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  topic          Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model XpTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyActivity {
  id       String @id @default(cuid())
  userId   String
  date     String
  xpEarned Int    @default(0)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model StreakTracking {
  id            String   @id @default(cuid())
  userId        String   @unique
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastActive    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RoadmapCompletion {
  id                   String   @id @default(cuid())
  userId               String
  roadmapId            String
  completionPercentage Int      @default(0)
  finalQuizScore       Int?
  challengeCompletion  Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap              Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([userId, roadmapId])
}

model TopicProgress {
  id           String    @id @default(cuid())
  userId       String
  topicId      String
  completed    Boolean   @default(false)
  lastAccessed DateTime  @default(now())
  completedAt  DateTime?
  topic        Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
}

model ChallengeProgress {
  id          String   @id @default(cuid())
  userId      String
  challengeId String
  completed   Boolean  @default(false)
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
}

model TutorSession {
  id        String         @id @default(cuid())
  userId    String
  topic     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  TutorMessage[]
}

model TutorMessage {
  id        String       @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime     @default(now())
  session   TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model SkillProficiency {
  id            String   @id @default(cuid())
  userId        String
  technology    String
  score         Int      @default(0)
  confidence    String   @default("Beginner")
  lastEvaluated DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, technology])
  @@index([userId])
}

model ProjectReview {
  id           String            @id @default(cuid())
  submissionId String            @unique
  overallScore Int
  readmeScore  Int
  codeQuality  Int
  testCoverage Int
  securityScore Int
  feedbackJson String
  createdAt    DateTime          @default(now())
  submission   ProjectSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model InterviewSession {
  id         String             @id @default(cuid())
  userId     String
  category   String
  technology String
  score      Int?
  feedback   String?
  status     String             @default("IN_PROGRESS")
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   InterviewMessage[]

  @@index([userId])
}

model InterviewMessage {
  id        String           @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime         @default(now())
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  eventName String
  metadata  Json?
  timestamp DateTime @default(now())

  @@index([eventName, timestamp])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt
}

model ContentVersion {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  version     Int      @default(1)
  dataJson    Json
  createdById String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model LessonDependency {
  id              String @id @default(cuid())
  lessonId        String
  prerequisiteId  String
  unlockCondition String @default("COMPLETED")
  lesson          Lesson @relation("TargetLesson", fields: [lessonId], references: [id], onDelete: Cascade)
  prerequisite    Lesson @relation("PrereqLesson", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([lessonId, prerequisiteId])
}

model GithubSync {
  id           String   @id @default(cuid())
  userId       String   @unique
  username     String
  avatarUrl    String?
  publicRepos  Int      @default(0)
  totalCommits Int      @default(0)
  totalPRs     Int      @default(0)
  languages    Json?
  lastSyncedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AssessmentQuality {
  id           String   @id @default(cuid())
  entityType   String
  entityId     String   @unique
  passRate     Float    @default(0.0)
  attempts     Int      @default(0)
  qualityScore Float    @default(100.0)
  isAmbiguous  Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   // "ACHIEVEMENT" | "PROJECT_REVIEW" | "INTERVIEW_FEEDBACK" | "MENTOR_SUGGESTION" | "COMMUNITY_REPLY" | "ANNOUNCEMENT"
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model SpacedRepetition {
  id             String   @id @default(cuid())
  userId         String
  topicId        String
  retentionScore Float    @default(100.0)
  lastReviewedAt DateTime @default(now())
  nextReviewDue  DateTime
  intervalDays   Int      @default(1)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId, nextReviewDue])
}

model ContentSource {
  id        String   @id @default(cuid())
  name      String
  type      String   // "RSS" | "MEDIUM" | "GITHUB" | "BLOG"
  url       String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExternalArticle {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  description    String
  content        String?
  author         String   @default("StackForge Content Engine")
  coverImage     String?
  tags           String[] @default([])
  readingTime    Int      @default(5)
  source         String
  sourceUrl      String
  canonicalUrl   String?
  mediumUrl      String?
  publishedAt    DateTime @default(now())
  score          Float    @default(100.0)
  keyTakeaways   String[] @default([])
  prerequisites String[] @default([])
  difficulty     String   @default("Intermediate")
  status         String   @default("PUBLISHED")
  isPinned       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([source, publishedAt])
}

model ExternalProject {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  description   String
  repoUrl       String
  stars         Int      @default(0)
  forks         Int      @default(0)
  language      String   @default("TypeScript")
  topics        String[] @default([])
  readmeContent String?
  ogImage       String?
  updatedAt     DateTime @updatedAt
}

model RSSFeed {
  id             String    @id @default(cuid())
  url            String    @unique
  sourceName     String
  lastFetchedAt  DateTime?
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
}

model SyncHistory {
  id          String   @id @default(cuid())
  sourceName  String
  itemsSynced Int      @default(0)
  status      String   @default("SUCCESS")
  errorLog    String?
  timestamp   DateTime @default(now())
}

model ContentCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  dataJson  Json
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([cacheKey, expiresAt])
}

model LearningNode {
  id                 String   @id @default(cuid())
  entityType         String   // "LESSON" | "ARTICLE" | "CHEATSHEET" | "QUIZ" | "CHALLENGE" | "PROJECT" | "INTERVIEW" | "CERTIFICATE"
  entityId           String
  title              String
  slug               String   @unique
  technology         String
  difficulty         String   @default("Intermediate")
  qualityScore       Float    @default(85.0)
  learningObjectives String[] @default([])
  prerequisites      String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([technology, difficulty])
}

model LearningEdge {
  id           String @id @default(cuid())
  sourceNodeId String
  targetNodeId String
  edgeType     String @default("NEXT_REC") // "PREREQUISITE" | "NEXT_REC" | "RELATED"
  weight       Float  @default(1.0)

  @@unique([sourceNodeId, targetNodeId])
}

model LearningCollection {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  icon        String   @default("Layers")
  color       String   @default("emerald")
  technology  String
  itemIds     String[] @default([])
  isFeatured  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WeeklyLearningReport {
  id               String   @id @default(cuid())
  userId           String
  weekStartDate    String
  progressScore    Int      @default(0)
  topicsImproved   String[] @default([])
  weakTopics       String[] @default([])
  projectsFinished Int      @default(0)
  readingSummary   String
  nextWeekPlan     String
  createdAt        DateTime @default(now())

  @@unique([userId, weekStartDate])
}
